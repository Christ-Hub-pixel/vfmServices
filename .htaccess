# ==============================================================================
# SÉCURITÉ & FIREWALL ANTI-HACKING MILITAIRE (WAF) - VFM SERVICES
# ==============================================================================

# 1. FORCER LE PROTOCOLE SÉCURISÉ HTTPS & GESTION DES URLS PROPRES (CLEAN URLS WITHOUT .HTML)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # A. Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # B. Rediriger /index.html vers la racine / (Clean URL)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

  # C. Rediriger Nos Realisations.html vers /realisations (Clean URL propre)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /Nos%20Realisations(\.html)?\ HTTP/ [NC]
  RewriteRule ^ https://%{HTTP_HOST}/realisations [R=301,L]

  # D. Rediriger les demandes externes /page.html vers /page (Redirection 301)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html\ HTTP/ [NC]
  RewriteRule ^([^/]+)\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

  # E. Réécriture interne pour servir la page HTML sans afficher .html dans la barre d'adresse
  # cas spécifique pour realisations -> Nos Realisations.html
  RewriteRule ^realisations/?$ "Nos Realisations.html" [L,NC]

  # cas général pour toute autre page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)$ $1.html [L]
</IfModule>


# 2. FIREWALL ANTI-HACKING WAF (BLOCAGE SQL INJECTION, RCE, XSS & PATH TRAVERSAL)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # A. BLOCAGE INJECTION SQL (SQLi)
  RewriteCond %{QUERY_STRING} (select|insert|update|delete|drop|union|concat|alter|exec|create|truncate|benchmark|waitfor|sleep) [NC]
  RewriteRule ^ - [F,L]

  # B. BLOCAGE ATTAQUES XSS DANS L'URL
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (javascript:|eval\(|onload=|onerror=|onclick=) [NC]
  RewriteRule ^ - [F,L]

  # C. BLOCAGE TRAVERSÉE DE RÉPERTOIRES (PATH TRAVERSAL / LFI / RFI)
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|/etc/passwd|win\.ini|proc/self/environ) [NC]
  RewriteRule ^ - [F,L]

  # D. BLOCAGE EXÉCUTION DE CODE A DISTANCE (RCE)
  RewriteCond %{QUERY_STRING} (base64_encode|base64_decode|passthru|shell_exec|system|phpinfo|popen) [NC]
  RewriteRule ^ - [F,L]

  # E. BLOCAGE DES SCANNERS DE VULNÉRABILITÉS & ROBOTS PIRATES
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|acunetix|wpscan|havij|nmap|netsparker|dirbuster|burpsuite|grabber) [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# 3. BLOCAGE DES MÉTHODES HTTP SUSPECTES (SEULS GET, POST, HEAD SONT AUTORISÉS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !(GET|POST|HEAD) [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# 4. EN-TÊTES DE SÉCURITÉ AVANCÉS (HARDENING HEADERS)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# 5. MASQUER L'EXPLORATION DES DOSSIERS (ANTI-ESPIONNAGE)
Options -Indexes

# 6. PROTECTION INTERDICTION FICHIERS CACHÉS & CONFIGURATION (COMPATIBILITÉ APACHE 2.4 / 2.2)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 7. COMPRESSION GZIP PERFORMANCE
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
